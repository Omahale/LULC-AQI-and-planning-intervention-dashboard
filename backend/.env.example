# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" or your GEE key.json to git.

# --- Google Earth Engine ---
GEE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GEE_KEY_PATH=./gee-key.json
GEE_PROJECT_ID=your-gcp-project-id
GEE_LULC_ASSET_ID=projects/your-gcp-project-id/assets/NMC_LULC_2024_v2
GEE_NMC_BOUNDARY_ASSET_ID=projects/your-gcp-project-id/assets/nmc_boundary

# --- Server ---
PORT=5000
FLASK_DEBUG=true
JWT_SECRET_KEY=change-this-secret-in-production

# --- MongoDB ---
# Local MongoDB
# MONGO_URI=mongodb://localhost:27017/lulc_aqi
# MongoDB Atlas example
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/lulc_aqi?retryWrites=true&w=majority
# MONGO_DB_NAME=lulc_aqi

# --- AQI live data ---
# Use a real air quality provider endpoint if you want live values.
# For example, OpenAQ, CPCB, or any custom endpoint that returns JSON.
# AQI_API_URL=https://your-aqi-endpoint.example/current
# AQI_TREND_URL=https://your-aqi-endpoint.example/trend
# AQI_HOTSPOTS_URL=https://your-aqi-endpoint.example/hotspots

# --- CORS: your frontend dev URL ---
FRONTEND_ORIGIN=http://localhost:5173
